# Copy this file to server/.env and fill in values from your OmniDimension dashboard.
# Keep the API key secret. Never put it in client/.env or frontend code.
OMNIDIM_API_KEY=replace_with_your_server_side_api_key
OMNIDIM_AGENT_ID=replace_with_your_numeric_agent_id
PORT=8787
CLIENT_ORIGIN=http://localhost:5173
